# Airtable — see README for table field definitions.
# Create a personal access token at https://airtable.com/create/tokens
# with scopes: data.records:read, data.records:write
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_SHOWS_TABLE=Shows (for Claude)
AIRTABLE_SUBSCRIBERS_TABLE=FanRM

# Preview lockdown (optional): while SITE_PASSWORD is set, the whole site is
# behind HTTP Basic Auth and marked noindex (see src/proxy.ts). Leave both
# blank/unset to launch publicly. Username defaults to "goldenflower".
SITE_PASSWORD=
SITE_USER=
